# Copy to .env for local-only tooling. Never commit .env.
APP_ENV=local
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace_with_local_google_web_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace_with_local_google_client_secret
